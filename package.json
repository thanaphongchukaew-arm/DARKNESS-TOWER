{
  "name": "darkness-tower",
  "private": true,
  "version": "0.23.0",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "start": "electron .",
    "build:exe": "npm run build && electron-builder --win",
    "smoke": "npm run build && electron scripts/smoke-test.js && electron scripts/audit-battle-layout.js --quick && electron scripts/audit-screens-layout.js --quick",
    "test:layout": "npm run build && electron scripts/audit-battle-layout.js",
    "test:all": "npm test && npm run test:functional && npm run test:layout && npm run test:screens && npm run test:visual && npm run test:a11y",
    "test:functional": "npm run build && electron scripts/functional-ui-test.js",
    "test:screens": "npm run build && electron scripts/audit-screens-layout.js",
    "balance": "node scripts/balance-sim.js",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test:ui": "npm run build && electron scripts/ui-polish-test.js",
    "art:pack": "electron scripts/pack-pixel16.js",
    "test:modes": "npm run build && electron scripts/modes-test.js",
    "sw:bump": "node scripts/sw-version.js --write",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:soak": "npm run build && electron scripts/soak-test.js",
    "test:browsers": "npm run build && node scripts/cross-browser-layout.js",
    "test:visual": "npm run build && electron scripts/visual-regression.js",
    "test:a11y": "npm run build && electron scripts/a11y-audit.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "^1.65.1",
    "terser": "^5.49.2"
  },
  "description": "DARKNESS TOWER — หอคอยแห่งความมืด 100 ชั้น",
  "author": "Thanaphong Chukaew",
  "main": "electron/main.js",
  "build": {
    "appId": "com.thanaphong.darknesstower",
    "productName": "DARKNESS TOWER",
    "copyright": "Copyright © Thanaphong Chukaew. All rights reserved.",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "index.html",
      "dist/**",
      "css/**",
      "fonts/**",
      "backgrounds/**",
      "assets/pixel16/**",
      "icons/**",
      "manifest.webmanifest",
      "!**/*-source.png",
      "!art-source/**",
      "!previews/**"
    ],
    "win": {
      "icon": "icons/android-chrome-512x512.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DARKNESS-TOWER.exe"
    },
    "mac": {
      "icon": "icons/android-chrome-512x512.png",
      "category": "public.app-category.role-playing-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icons/android-chrome-512x512.png",
      "category": "Game",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
